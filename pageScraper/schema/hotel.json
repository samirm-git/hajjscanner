 { 
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hotel.json",
  "title": "Hotel",
  "type": ["object", "null"],
  "properties": {
      "name": {
        "type": ["string", "null"],
        "minLength": 2,
        "maxLength": 100,
        "minItems": 1
      },
      "total_days": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 20,
        "minItems": 1
      },
      "images": {
        "type": ["array", "null"],
        "items": { "type": "string", "format": "uri" },
        "minItems": 1,
        "uniqueItems": true
      },
      "stars": {
        "type": ["integer", "null"],
        "description": "hotel star rating from 1 to 5",
        "minimum": 1,
        "maximum": 5,
        "minItems": 1
      },
      "has_wifi":{
        "type":["boolean", "null"],
        "description": "True if hotel provides wifi. False otherwise"
      },
      "has_ac":{
        "type":["boolean", "null"],
        "description": "True if hotel room has air conditioning (AC). False otherwise"
      },
      "other_amenities":{
        "type":["string", "null"],
        "description": "Description of any other amenities the hotel provides"
      },
      "distance_to_haram": {
        "description": "distance to the haram in meters",
        "type": ["integer", "null"],
        "minimum": 500,
        "maximum": 4000,
        "minItems": 1
      },
      "walk_to_haram": {
        "description": "time taken to walk to the haram in minutes",
        "type": ["integer", "null"],
        "minimum": 2,
        "maximum": 40,
        "minItems": 1
      },

      "number_of_beds":{
        "description": "number of beds in hotel room",
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 6,
        "minItems":1
      }
      },
      "required": ["total_days", "name", "images", "stars", "has_wifi", "has_ac", "distance_to_haram", "walk_to_haram", "number_of_beds"]
    }
      